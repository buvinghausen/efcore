@@ -59,4 +66,76 @@ protected override Expression ProcessTypeMappings(Expression expression)
     /// </summary>
     protected override Expression Prune(Expression query)
         => _pruner.Prune(query);
+
+    // SPIKE(temporal-split): throwaway survivor check — walks the pruned tree; if any table
+    // expression carrying a temporal-operation annotation shares an entity with a mapping
+    // fragment whose table also survived pruning, the query depends on non-temporal fragment
+    // data and is rejected with a guided error.
+    private static void SpikeCheckTemporalFragmentSurvivors(Expression query)
+    {
+        var collector = new SpikeTableCollector();
+        collector.Visit(query);
+
+        if (collector.StampedTables.Count == 0)
+        {
+            return;
+        }
+
+        var bannedFragmentTables = new HashSet<(string Name, string? Schema)>();
+        foreach (var stamped in collector.StampedTables)
+        {
+            foreach (var mapping in stamped.EntityTypeMappings)
+            {
+                if (mapping.TypeBase is IEntityType entityType)
+                {
+                    foreach (var fragment in entityType.GetMappingFragments(StoreObjectType.Table))
+                    {
+                        bannedFragmentTables.Add((fragment.StoreObject.Name, fragment.StoreObject.Schema));
+                    }
+                }
+            }
+        }
+
+        var survivors = collector.AllTables
+            .Where(t => bannedFragmentTables.Contains((t.Name, t.Schema)))
+            .Select(t => t.Name)
+            .Distinct()
+            .ToList();
+
+        if (survivors.Count > 0)
+        {
+            throw new InvalidOperationException(
+                "SPIKE: The temporal query requires members mapped to non-temporal fragment table(s) "
+                + string.Join(", ", survivors)
+                + ". Project only members mapped to the principal table.");
+        }
+    }
+
+    private sealed class SpikeTableCollector : ExpressionVisitor
+    {
+        public List<ITableBase> StampedTables { get; } = [];
+        public List<ITableBase> AllTables { get; } = [];
+
+        protected override Expression VisitExtension(Expression node)
+        {
+            switch (node)
+            {
+                case TableExpression tableExpression:
+                    AllTables.Add(tableExpression.Table);
+                    if (tableExpression.FindAnnotation(SqlServerAnnotationNames.TemporalOperationType) is not null)
+                    {
+                        StampedTables.Add(tableExpression.Table);
+                    }
+
+                    return node;
+
+                case ShapedQueryExpression shapedQueryExpression:
+                    Visit(shapedQueryExpression.QueryExpression);
+                    return node;
+
+                default:
+                    return base.VisitExtension(node);
+            }
+        }
+    }
 }
